<div class="project-card">
  <a href="{{ project.url | relative_url }}" class="card-link">
    <div class="card-content">
      <h3 class="card-title">{{ project.title }}</h3>
      <div class="project-overview">
        {{ content }}
      </div>
      {% if project.subtitle %}
      <p class="card-subtitle">{{ project.subtitle }}</p>
      {% endif %}
      <div class="card-tags">
        {% for tag in project.tags %}
          <span class="tag">{{ tag }}</span>
        {% endfor %}
      </div>
    </div>

    <div class="card-image-container">
      {% if project.preview_split %}
        <!-- Split view: same image shown twice with different focus -->
        <div class="split-preview">
          <div class="split-left">
            {% if project.preview_gif contains '.mp4' %}
              <video autoplay loop muted playsinline class="card-gif"
                     style="object-position: {{ project.preview_split.left | default: 'left' }};">
                <source src="{{ project.preview_gif | relative_url }}" type="video/mp4">
              </video>
            {% elsif project.preview_gif contains '.webm' %}
              <video autoplay loop muted playsinline class="card-gif"
                     style="object-position: {{ project.preview_split.left | default: 'left' }};">
                <source src="{{ project.preview_gif | relative_url }}" type="video/webm">
              </video>
            {% else %}
              <img src="{{ project.preview_gif | relative_url }}" 
                   alt="{{ project.title }} - left view" 
                   class="card-gif"
                   style="object-position: {{ project.preview_split.left | default: 'left' }};">
            {% endif %}
          </div>
          <div class="split-right">
            {% if project.preview_gif contains '.mp4' %}
              <video autoplay loop muted playsinline class="card-gif"
                     style="object-position: {{ project.preview_split.right | default: 'right' }};">
                <source src="{{ project.preview_gif | relative_url }}" type="video/mp4">
              </video>
            {% elsif project.preview_gif contains '.webm' %}
              <video autoplay loop muted playsinline class="card-gif"
                     style="object-position: {{ project.preview_split.right | default: 'right' }};">
                <source src="{{ project.preview_gif | relative_url }}" type="video/webm">
              </video>
            {% else %}
              <img src="{{ project.preview_gif | relative_url }}" 
                   alt="{{ project.title }} - right view" 
                   class="card-gif"
                   style="object-position: {{ project.preview_split.right | default: 'right' }};">
            {% endif %}
          </div>
        </div>
      {% else %}
        <!-- Standard single view -->
        {% if project.preview_gif contains '.mp4' %}
          <video autoplay loop muted playsinline class="card-gif"
                 style="object-position: {{ project.preview_position | default: 'center' }};">
            <source src="{{ project.preview_gif | relative_url }}" type="video/mp4">
          </video>
        {% elsif project.preview_gif contains '.webm' %}
          <video autoplay loop muted playsinline class="card-gif"
                 style="object-position: {{ project.preview_position | default: 'center' }};">
            <source src="{{ project.preview_gif | relative_url }}" type="video/webm">
          </video>
        {% else %}
          <img src="{{ project.preview_gif | relative_url }}" 
               alt="{{ project.title }}" 
               class="card-gif"
               style="object-position: {{ project.preview_position | default: 'center' }};">
        {% endif %}
      {% endif %}
      <div class="card-overlay">
        <span class="view-project-text">View Project</span>
      </div>
    </div>
  </a>
</div>